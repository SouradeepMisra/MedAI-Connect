# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored - never commit real secrets.
#
# docker-compose.yml loads this file into the backend container via `env_file`,
# so `docker compose up` will fail until backend/.env exists.

# --- Auth ---
# Secret used to sign login tokens (JWT). Use a long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
# Inside Docker Compose this is overridden to mongodb://mongodb:27017/medai-connect
# (containers reach each other by service name). Running the backend directly on
# your machine instead? Use: mongodb://localhost:27017/medai-connect
MONGODB_URI=mongodb://mongodb:27017/medai-connect

# --- OpenAI (powers the AI document verification and the symptom chat) ---
# Create a key at https://platform.openai.com/api-keys (needs prepaid API credit).
# Without a real key the app still runs; the two AI features return a clean error.
OPENAI_API_KEY=your-openai-api-key
# Vision-capable model used to read doctor registration documents.
OPENAI_VISION_MODEL=gpt-4o
# Text model used by the patient symptom-guidance chat.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- App behaviour ---
# Minimum amount accepted when a patient books an appointment (no real payment gateway).
MIN_BOOKING_AMOUNT=100
# Origin allowed to call the API from a browser (CORS). Must match where the frontend runs.
FRONTEND_URL=http://localhost:5173
