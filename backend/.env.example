# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored - never commit real secrets.
#
# docker-compose.yml loads this file into the backend container via `env_file`,
# so `docker compose up` will fail until backend/.env exists.

# --- Auth ---
# Secret used to sign login tokens (JWT). Use a long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
# Inside Docker Compose this is overridden to mongodb://mongodb:27017/medai-connect
# (containers reach each other by service name). Running the backend directly on
# your machine instead? Use: mongodb://localhost:27017/medai-connect
MONGODB_URI=mongodb://mongodb:27017/medai-connect

# --- AI provider (powers the AI document verification and the symptom chat) ---
# Without a real key the app still runs; the two AI features return a clean error.
# Any OpenAI-API-compatible provider works - see docs/06-Setup-and-Run-Guide.md section 4.
#
# Option 1: OpenAI (needs prepaid credit, min $5) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Vision-capable model used to read doctor registration documents.
OPENAI_VISION_MODEL=gpt-4o
# Text model used by the patient symptom-guidance chat.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Leave OPENAI_BASE_URL unset for OpenAI.
#
# Option 2: Google Gemini (free tier, no card) - uncomment these 4 lines instead,
# comment out the 3 OpenAI lines above, and get a key at https://aistudio.google.com/apikey
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_VISION_MODEL=gemini-2.5-flash-lite
# OPENAI_CHAT_MODEL=gemini-2.5-flash-lite
# Flash-Lite models keep the largest free daily quota; confirm the current model name and
# limits at https://ai.google.dev/gemini-api/docs/rate-limits before relying on this.

# --- App behaviour ---
# Minimum amount accepted when a patient books an appointment (no real payment gateway).
MIN_BOOKING_AMOUNT=100
# Origin allowed to call the API from a browser (CORS). Must match where the frontend runs.
FRONTEND_URL=http://localhost:5173
